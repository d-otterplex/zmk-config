#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
  keymap {
    compatible = "zmk,keymap";

    default_layer {
      bindings = <
        &kp Q &kp W &kp F &kp P &kp B &kp J &kp L &kp U
        &kp A &kp R &kp S &kp T &kp G &kp M &kp N &kp E
        &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8
        &kp Z &kp X &kp C &kp D &kp V &kp K &kp H &bootloader
      >;
    };
  };
};

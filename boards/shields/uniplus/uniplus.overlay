#include <physical_layouts.dtsi>
#include <dt-bindings/zmk/matrix_transform.h>

&xiao_spi {
  status = "okay";
  cs-gpios = <&xiao_d 0 GPIO_ACTIVE_LOW>;
  shifter: 595@0 {
    compatible = "zmk,gpio-595";
    status = "okay";
    gpio-controller;
    spi-max-frequency = <200000>;
    reg = <0>;
    #gpio-cells = <2>;
    ngpios = <8>;
  };
};

/ {
  chosen {
    zmk,kscan = &kscan0;
    zmk,physical-layout = &phys0_def_layout;
  };

  phys0_def_layout: phys0_def_layout {
    compatible = "zmk,physical-layout";
    display-name = "Default Layout";
    transform = <&def_transform>;
  };

  phys0_alt_layout: phys0_alt_layout {
    compatible = "zmk,physical-layout";
    display-name = "Default Layout, Alternate Representation";
    transform = <&alt_transform>;
  };

  def_transform: keymap_transform_0 {
    compatible = "zmk,matrix-transform";
    columns = <10>;
    rows = <4>;
    // Left, Right
    // Thumbs
    map = <
      RC(3,0) RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(3,7)
      RC(3,1) RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(3,6)
      RC(3,2) RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(3,5)
                      RC(4,0) RC(4,1) RC(3,3) RC(3,4)
    >;
  };

  alt_transform: keymap_transform_1 {
    compatible = "zmk,matrix-transform";
    columns = <10>;
    rows = <4>;
    // Left
    // Right
    // Thumbs
    map = <
      RC(3,0) RC(0,0) RC(0,1) RC(0,2) RC(0,3)
      RC(3,1) RC(1,0) RC(1,1) RC(1,2) RC(1,3)
      RC(3,2) RC(2,0) RC(2,1) RC(2,2) RC(2,3)

      RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(3,7)
      RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(3,6)
      RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(3,5)       
      RC(4,0) RC(4,1) RC(3,3) RC(3,4)
    >;
  };

  kscan0: kscan_composite {
    compatible = "zmk,kscan-composite";
    rows = <5>;
    columns = <8>;

    matrix {
     kscan = <&kscan1>;
    };

    direct {
     kscan = <&kscan2>;
     row-offset = <4>;
    };
  };

  kscan1: kscan_matrix {
    compatible = "zmk,kscan-gpio-matrix";
    diode-direction = "col2row";

    col-gpios
     = <&shifter 7 GPIO_ACTIVE_HIGH>
     , <&shifter 6 GPIO_ACTIVE_HIGH>
     , <&shifter 5 GPIO_ACTIVE_HIGH>
     , <&shifter 4 GPIO_ACTIVE_HIGH>
     , <&shifter 3 GPIO_ACTIVE_HIGH>
     , <&shifter 2 GPIO_ACTIVE_HIGH>
     , <&shifter 1 GPIO_ACTIVE_HIGH>
     , <&shifter 0 GPIO_ACTIVE_HIGH>
     ;

    row-gpios
     = <&xiao_d 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
     , <&xiao_d 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
     , <&xiao_d 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
     , <&xiao_d 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
     ;
  };

  kscan2: kscan_direct {
    compatible = "zmk,kscan-gpio-direct";
    wakeup-source;
    input-gpios
     = <&xiao_d 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
     , <&xiao_d 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
     ;
  };

  encoder_evqwgd: encoder_evqwgd {
    compatible = "alps,ec11";
    a-gpios = <&xiao_d 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
    b-gpios = <&xiao_d 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
    steps = <30>;
    status = "okay";
  };

  sensors: sensors {
    compatible = "zmk,keymap-sensors";
    sensors = <&encoder_evqwgd>;
    triggers-per-rotation = <15>;
  };
};
